# Copy to web/.env.local to override. With no file at all the default below is
# used, so `npm run dev` works against `make serve` out of the box.
#
# Server-side only (no NEXT_PUBLIC_ prefix): the browser talks to this app's
# own /api routes, which forward to the address below. That keeps the demo
# free of CORS configuration and lets a dead backend become a readable banner
# instead of a failed fetch in the console.
#
# If searches fail with a connection error while uvicorn is clearly running,
# use 127.0.0.1 rather than localhost — Node resolves `localhost` to ::1 first
# on many Macs, while uvicorn binds 127.0.0.1 by default.
CONCIERGE_API_URL=http://localhost:8000
